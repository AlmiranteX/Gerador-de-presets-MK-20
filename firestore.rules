rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint: UserQuota (/users/{userId})
    function isValidUserQuota(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 120)) &&
             data.dailyDate is string &&
             data.dailyDate.size() == 10 &&
             data.dailyDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.dailyCount is int &&
             data.dailyCount >= 0 &&
             data.dailyCount <= 100 &&
             data.proLifetime is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Validation Blueprint: CloudPreset (/users/{userId}/presets/{presetId})
    function isValidCloudPreset(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 && data.title.size() <= 120 &&
             data.song is string &&
             data.song.size() <= 120 &&
             data.style is string &&
             data.style.size() <= 80 &&
             data.bpm is int &&
             data.bpm >= 20 && data.bpm <= 300 &&
             data.youtubeUrl is string &&
             data.youtubeUrl.size() <= 500 &&
             data.details is string &&
             data.details.size() <= 2000 &&
             data.jsonContent is string &&
             data.jsonContent.size() >= 2 && data.jsonContent.size() <= 50000 &&
             data.favorite is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Collection Rules: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    request.auth.uid == userId;

      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserQuota(incoming(), userId) &&
                       incoming().keys().hasAll(['userId', 'dailyDate', 'dailyCount', 'proLifetime', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'dailyDate', 'dailyCount', 'proLifetime', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserQuota(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'dailyDate', 'dailyCount', 'proLifetime', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;

      // Subcollection Rules: /users/{userId}/presets/{presetId}
      match /presets/{presetId} {
        allow get: if isSignedIn() &&
                      isValidId(userId) &&
                      isValidId(presetId) &&
                      request.auth.uid == userId;

        allow list: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(presetId) &&
                         request.auth.uid == userId &&
                         isValidCloudPreset(incoming(), userId) &&
                         incoming().keys().hasAll(['userId', 'title', 'song', 'style', 'bpm', 'youtubeUrl', 'details', 'jsonContent', 'favorite', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'song', 'style', 'bpm', 'youtubeUrl', 'details', 'jsonContent', 'favorite', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(presetId) &&
                         request.auth.uid == userId &&
                         isValidCloudPreset(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'song', 'style', 'bpm', 'youtubeUrl', 'details', 'jsonContent', 'favorite', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(presetId) &&
                         request.auth.uid == userId;
      }
    }
  }
}
